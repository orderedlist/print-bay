{
  "name": "@print-bay/desktop",
  "productName": "Print Bay",
  "version": "0.1.0",
  "description": "A workspace for the Creality K2: models, slicing and printing",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "node bundle.mjs",
    "dist": "node bundle.mjs && electron-builder --mac --publish never",
    "dist:notarize": "node bundle.mjs && electron-builder --mac --publish never -c.mac.notarize=true",
    "release": "node bundle.mjs && electron-builder --mac --publish always -c.mac.notarize=true"
  },
  "build": {
    "appId": "com.boxoutdesigns.printbay",
    "productName": "Print Bay",
    "copyright": "Steve Smith",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "updater.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/printbay",
        "to": "printbay"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": false,
      "icon": "icon.png",
      "artifactName": "Print-Bay-${version}-${arch}.${ext}",
      "identity": "Steve Smith (BJ2LT5F6JX)"
    },
    "dmg": {
      "title": "Print Bay ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "orderedlist",
        "repo": "print-bay",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
