#!/bin/zsh
# Printability checks for a model as it will be sliced (app/server/dist/check-cli.js):
#   scripts/check tote-rack
# A plain path, so Claude's permission rules can name it. Inside the packaged app there's no
# `node`, so the app passes its own binary as PRINT_BAY_NODE and runs it as Node.
set -e
root=${0:A:h:h}
if [[ -n $PRINT_BAY_NODE ]]; then
  ELECTRON_RUN_AS_NODE=1 exec "$PRINT_BAY_NODE" "$root/app/server/dist/check-cli.js" "$@"
fi
exec node "$root/app/server/dist/check-cli.js" "$@"
